fn add(left: int, right: int) -> int:
    return left + right

fn announce() -> none:
    log "Swan compiler ready"
    return

fn greet() -> none:
    log "A second function owns a separate string"
    return

fn main() -> int:
    let answer = add(20, 22)
    if answer > 2:
        log answer
    else:
        log 0
    announce()
    greet()
    return answer
