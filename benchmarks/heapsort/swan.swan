# 1,000,000,000 deterministic u32 values, sorted in place with max-heapsort.
func main() -> int:
    let count = 1000000000
    let values = array_u32_unchecked(count)
    var state = 305419896

    var i = 0
    while i < count
        state = (state * 1664525 + 1013904223) % 4294967296
        values[i] = state
        i = i + 1

    var start = count // 2 - 1
    while start >= 0
        var root = start
        while root * 2 + 1 < count
            let left = root * 2 + 1
            var largest = left
            let right = left + 1
            if right < count
                if values[right] > values[left]
                    largest = right
            if values[root] < values[largest]
                let temporary = values[root]
                values[root] = values[largest]
                values[largest] = temporary
                root = largest
            else
                break
        start = start - 1

    var end = count - 1
    while end > 0
        let extract_temp = values[0]
        values[0] = values[end]
        values[end] = extract_temp
        end = end - 1

        var extract_root = 0
        while extract_root * 2 + 1 <= end
            let extract_left = extract_root * 2 + 1
            var extract_largest = extract_left
            let extract_right = extract_left + 1
            if extract_right <= end
                if values[extract_right] > values[extract_left]
                    extract_largest = extract_right
            if values[extract_root] < values[extract_largest]
                let extract_swap = values[extract_root]
                values[extract_root] = values[extract_largest]
                values[extract_largest] = extract_swap
                extract_root = extract_largest
            else
                break

    var checksum: u32 = 0
    i = 0
    while i < count
        if i > 0
            if values[i - 1] > values[i]
                log "SORT_FAILED"
                return 2
        checksum = checksum + values[i]
        i = i + 1

    log checksum
    return 0

out
