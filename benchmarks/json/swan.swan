import C "runtime/json_abi.h"

func main() -> int:
    let payload = "{\"id\":42,\"workers\":128,\"enabled\":true,\"service\":\"swan\",\"items\":[1,2,3,4,5],\"meta\":{\"region\":\"ap-southeast-1\",\"version\":1}}"
    let document = swan_json_create(64)
    if document == 0:
        return 1

    var request = 0
    while request < 100000:
        if swan_json_parse_text(document, payload) != 1:
            return 2
        if swan_json_compact_length(document) <= 0:
            return 3
        request = request + 1

    let checksum = (swan_json_get_i64(document, "id", -1) + swan_json_get_i64(document, "workers", -1)) * 100000
    let bytes = (swan_json_input_length(document) + swan_json_compact_length(document)) * 100000
    swan_json_close(document)
    !printin >> checksum
    !printin >> bytes
    return 0
