# Deterministic binary-search workload: 20M values and 20M queries.
fn main() -> int:
    let values = array_unchecked(20000000)
    var i = 0
    while i < 20000000
        values[i] = i
        i = i + 1

    var query = 0
    var checksum = 0
    var target = 0
    while query < 20000000
        var low = 0
        var high = 19999999
        var found = -1
        while low <= high
            var middle = low + (high - low) // 2
            var value = values[middle]
            if value == target
                found = value
                break
            else
                if value < target
                    low = middle + 1
                else
                    high = middle - 1
        checksum = checksum + found
        target = target + 7919
        if target >= 20000000
            target = target - 20000000
        query = query + 1
    log checksum
    return 0

