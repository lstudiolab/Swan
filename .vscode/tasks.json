{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Swan: Build current file",
      "type": "process",
      "command": "swan",
      "args": [
        "build",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Swan: Run current file",
      "type": "process",
      "command": "swan",
      "args": [
        "run",
        "${file}"
      ],
      "problemMatcher": []
    }
  ]
}
