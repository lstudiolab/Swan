{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Swan: Transpile current file to C",
      "type": "process",
      "command": "swan",
      "args": ["${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}.c"],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
