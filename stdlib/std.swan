# Swan standard library
# Import with: import std
# Access public functions through the std: namespace.
# Output is a language intrinsic: std:print >> expression

func abs(value: int) -> int:
    if value < 0:
        return 0 - value
    return value

func min(left: int, right: int) -> int:
    if left < right:
        return left
    return right

func max(left: int, right: int) -> int:
    if left > right:
        return left
    return right

func clamp(value: int, lower: int, upper: int) -> int:
    if lower > upper:
        return lower
    if value < lower:
        return lower
    if value > upper:
        return upper
    return value

func sign(value: int) -> int:
    if value < 0:
        return 0 - 1
    if value > 0:
        return 1
    return 0

func square(value: int) -> int:
    return value * value

func cube(value: int) -> int:
    return value * value * value

func power(base: int, exponent: int) -> int:
    var result: int = 1
    var count: int = 0
    if exponent < 0:
        return 0
    while count < exponent:
        result = result * base
        count = count + 1
    return result

func factorial(value: int) -> int:
    var result: int = 1
    var count: int = 2
    if value < 0:
        return 0
    while count <= value:
        result = result * count
        count = count + 1
    return result

func sum_to(value: int) -> int:
    var result: int = 0
    var count: int = 1
    if value < 1:
        return 0
    while count <= value:
        result = result + count
        count = count + 1
    return result

func is_even(value: int) -> bool:
    return value % 2 == 0

func is_odd(value: int) -> bool:
    return value % 2 != 0

func in_range(value: int, lower: int, upper: int) -> bool:
    return value >= lower and value <= upper

func average(left: int, right: int) -> int:
    return (left + right) / 2
