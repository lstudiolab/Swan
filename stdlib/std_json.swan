# Swan JSON module
# Opaque document and string pointers use the x86-64 integer-register ABI.
export C external func swan_json_create(initial_token_capacity: int) -> int
export C external func swan_json_parse_text(document: int, input: int) -> int
export C external func swan_json_input_length(document: int) -> int
export C external func swan_json_get_i64(document: int, key: int, fallback: int) -> int
export C external func swan_json_has_key(document: int, key: int) -> int
export C external func swan_json_compact(document: int) -> int
export C external func swan_json_compact_length(document: int) -> int
export C external func swan_json_pretty(document: int) -> int
export C external func swan_json_error(document: int) -> int
export C external func swan_json_close(document: int)

func json_create(initial_token_capacity: int) -> int:
    return swan_json_create(initial_token_capacity)

func json_parse(document: int, input: int) -> int:
    return swan_json_parse_text(document, input)

func json_input_length(document: int) -> int:
    return swan_json_input_length(document)

func json_close(document: int):
    swan_json_close(document)

func json_get_i64(document: int, key: int, fallback: int) -> int:
    return swan_json_get_i64(document, key, fallback)

func json_has_key(document: int, key: int) -> int:
    return swan_json_has_key(document, key)

func json_compact(document: int) -> int:
    return swan_json_compact(document)

func json_compact_length(document: int) -> int:
    return swan_json_compact_length(document)

func json_pretty(document: int) -> int:
    return swan_json_pretty(document)

func json_error(document: int) -> int:
    return swan_json_error(document)
