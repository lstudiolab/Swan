# Swan Foundation
# Dependency-free integer helpers and the echo! output intrinsic.

func foundation_hello() -> int:
    echo!("Foundation standard library ready")
    return 0

func echo_int(value: int) -> void:
    log value

func echo_bool(value: bool) -> void:
    log value

func abs_int(value: int) -> int:
    if value < 0:
        return 0 - value
    return value

func min_int(left: int, right: int) -> int:
    if left < right:
        return left
    return right

func max_int(left: int, right: int) -> int:
    if left > right:
        return left
    return right

func clamp_int(value: int, lower: int, upper: int) -> int:
    if lower > upper:
        return lower
    if value < lower:
        return lower
    if value > upper:
        return upper
    return value

func sign_int(value: int) -> int:
    if value < 0:
        return 0 - 1
    if value > 0:
        return 1
    return 0

func square_int(value: int) -> int:
    return value * value

func cube_int(value: int) -> int:
    return value * value * value

func power_int(base: int, exponent: int) -> int:
    var result: int = 1
    var count: int = 0
    if exponent < 0:
        return 0
    while count < exponent:
        result = result * base
        count = count + 1
    return result

func factorial_int(value: int) -> int:
    var result: int = 1
    var count: int = 2
    if value < 0:
        return 0
    while count <= value:
        result = result * count
        count = count + 1
    return result

func sum_to_int(value: int) -> int:
    var result: int = 0
    var count: int = 1
    if value < 1:
        return 0
    while count <= value:
        result = result + count
        count = count + 1
    return result

func is_even(value: int) -> bool:
    return value % 2 == 0

func is_odd(value: int) -> bool:
    return value % 2 != 0

func in_range_int(value: int, lower: int, upper: int) -> bool:
    return value >= lower and value <= upper

func average_int(left: int, right: int) -> int:
    return (left + right) / 2

