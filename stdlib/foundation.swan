// Swan Foundation
// Small, dependency-free utilities implemented in Swan.
//
// Output
fn echo(message: string) -> void {
    log message;
}

fn echo_int(value: int) -> void {
    log value;
}

fn echo_float(value: float) -> void {
    log value;
}

fn echo_bool(value: bool) -> void {
    log value;
}

// Integer arithmetic
fn abs_int(value: int) -> int {
    if value < 0 {
        return 0 - value;
    }
    return value;
}

fn min_int(left: int, right: int) -> int {
    if left < right {
        return left;
    }
    return right;
}

fn max_int(left: int, right: int) -> int {
    if left > right {
        return left;
    }
    return right;
}

fn clamp_int(value: int, lower: int, upper: int) -> int {
    if lower > upper {
        return lower;
    }
    if value < lower {
        return lower;
    }
    if value > upper {
        return upper;
    }
    return value;
}

fn sign_int(value: int) -> int {
    if value < 0 {
        return 0 - 1;
    }
    if value > 0 {
        return 1;
    }
    return 0;
}

fn square_int(value: int) -> int {
    return value * value;
}

fn cube_int(value: int) -> int {
    return value * value * value;
}

fn power_int(base: int, exponent: int) -> int {
    var result: int = 1;
    var count: int = 0;
    if exponent < 0 {
        return 0;
    }
    while count < exponent {
        result = result * base;
        count = count + 1;
    }
    return result;
}

fn factorial_int(value: int) -> int {
    var result: int = 1;
    var count: int = 2;
    if value < 0 {
        return 0;
    }
    while count <= value {
        result = result * count;
        count = count + 1;
    }
    return result;
}

fn sum_to_int(value: int) -> int {
    var result: int = 0;
    var count: int = 1;
    if value < 1 {
        return 0;
    }
    while count <= value {
        result = result + count;
        count = count + 1;
    }
    return result;
}

// Integer predicates
fn is_even(value: int) -> bool {
    return value % 2 == 0;
}

fn is_odd(value: int) -> bool {
    return value % 2 != 0;
}

fn in_range_int(value: int, lower: int, upper: int) -> bool {
    return value >= lower and value <= upper;
}

// Numeric conversion-free helpers
fn average_int(left: int, right: int) -> float {
    return (left + right) / 2;
}
