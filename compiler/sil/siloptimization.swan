import silpass
import sildemand
import silverify

# Complete scalar SIL pass pipeline: verify, fold, demand, DCE, verify.
# Workspace is caller-owned and shared by all passes.
fn sil_optimize(state: u32_array, count: int, workspace: u32_array) -> int:
    if sil_verify(state, count) != 1
        return -1
    if sil_fold_constants(state, count, workspace) < 0
        return -1
    if sil_demand(state, count, workspace) < 1
        return -1
    var read = 0
    var write = 0
    while read < count
        let source = read * 5
        if workspace[256 + read] == 1
            let target = write * 5
            state[target] = state[source]
            state[target + 1] = state[source + 1]
            state[target + 2] = state[source + 2]
            state[target + 3] = state[source + 3]
            state[target + 4] = state[source + 4]
            write = write + 1
        read = read + 1
    if sil_verify(state, write) != 1
        return -1
    return write

