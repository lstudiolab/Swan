# Swan-authored scalar constant folding.
# Workspace layout: known[512..767], constants[768..1023].
fn sil_fold_constants(state: u32_array, count: int, workspace: u32_array) -> int:
    if count < 1 or count > 256
        return -1
    # Clear caller-owned analysis state so repeated invocations cannot reuse
    # constants from a previous function or compilation.
    var clear = 512
    while clear < 1024
        workspace[clear] = 0
        clear = clear + 1
    var index = 0
    while index < count
        let base = index * 5
        let encoded = state[base]
        let opcode = encoded % 16
        let value_type = encoded / 16
        let destination = state[base + 1]
        let left = state[base + 2]
        let right = state[base + 3]
        if opcode == 1
            workspace[512 + destination] = 1
            workspace[768 + destination] = state[base + 4]
        if opcode >= 2 and opcode <= 8
            if workspace[512 + left] == 1 and workspace[512 + right] == 1
                let raw_a = workspace[768 + left]
                let raw_b = workspace[768 + right]
                var a = raw_a
                var b = raw_b
                # Folded values are stored as signed 32-bit bit patterns in the
                # u32 workspace. Sign-extend them before arithmetic/comparison.
                if a > 2147483647
                    a = a - 4294967296
                if b > 2147483647
                    b = b - 4294967296
                var folded = 0
                var can_fold = 1
                if opcode == 2
                    folded = a + b
                if opcode == 3
                    folded = a - b
                if opcode == 4
                    folded = a * b
                if opcode == 5 and b == 0
                    can_fold = 0
                if opcode == 5 and a == -2147483648 and b == -1
                    can_fold = 0
                if opcode == 5 and b != 0 and (a != -2147483648 or b != -1)
                    folded = a / b
                if opcode == 6 and b == 0
                    can_fold = 0
                if opcode == 6 and a == -2147483648 and b == -1
                    can_fold = 0
                if opcode == 6 and b != 0 and not (a == -2147483648 and b == -1)
                    folded = a % b
                if opcode == 7
                    folded = a == b
                if opcode == 8
                    folded = a < b
                # The SIL record stores one 32-bit immediate. Leave wider
                # results as operations for the typed SVM optimizer to fold.
                if folded < -2147483648 or folded > 2147483647
                    can_fold = 0
                if can_fold == 1
                    state[base] = value_type * 16 + 1
                    state[base + 2] = 0
                    state[base + 3] = 0
                    state[base + 4] = folded
                    workspace[512 + destination] = 1
                    workspace[768 + destination] = folded
                if can_fold == 0
                    workspace[512 + destination] = 0
            if workspace[512 + left] != 1 or workspace[512 + right] != 1
                workspace[512 + destination] = 0
        if opcode == 9 and workspace[512 + left] == 1
            state[base] = value_type * 16 + 1
            state[base + 2] = 0
            state[base + 3] = 0
            state[base + 4] = workspace[768 + left]
            workspace[512 + destination] = 1
            workspace[768 + destination] = workspace[768 + left]
        if opcode == 9 and workspace[512 + left] != 1
            workspace[512 + destination] = 0
        index = index + 1
    return count


out