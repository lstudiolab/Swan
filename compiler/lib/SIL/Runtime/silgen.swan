# Swan-authored SIL builder.
# Record layout: [encoded opcode, result, lhs, rhs, immediate].
# Opcode = value_type * 16 + operation; types 1=i32, 2=i64, 3=bool.
# Operations: const=1, add=2, sub=3, mul=4, sdiv=5, srem=6,
# icmp_eq=7, icmp_slt=8, copy=9, return=10, parameter=11.

fn sil_emit_param(state: u32_array, count: int, packed: int) -> int:
    if count < 0 or count >= 256
        return -1
    let destination = packed / 1048576
    let value_type = (packed / 65536) % 16
    let parameter = packed % 65536
    let base = count * 5
    state[base] = value_type * 16 + 11
    state[base + 1] = destination
    state[base + 2] = 0
    state[base + 3] = 0
    state[base + 4] = parameter
    return count + 1

fn sil_emit_const(state: u32_array, count: int, packed: int) -> int:
    if count < 0 or count >= 256
        return -1
    let destination = packed / 1048576
    let value_type = (packed / 65536) % 16
    let value = packed % 65536
    let base = count * 5
    state[base] = value_type * 16 + 1
    state[base + 1] = destination
    state[base + 2] = 0
    state[base + 3] = 0
    state[base + 4] = value
    return count + 1

fn sil_emit_binary(state: u32_array, count: int, packed: int) -> int:
    if count < 0 or count >= 256
        return -1
    let opcode = packed / 16777216
    let destination = (packed / 65536) % 256
    let left = (packed / 256) % 256
    let right = packed % 256
    let base = count * 5
    state[base] = opcode
    state[base + 1] = destination
    state[base + 2] = left
    state[base + 3] = right
    state[base + 4] = 0
    return count + 1

fn sil_emit_return(state: u32_array, count: int, value: int) -> int:
    if count < 0 or count >= 256
        return -1
    let base = count * 5
    state[base] = 10
    state[base + 1] = 0
    state[base + 2] = value
    state[base + 3] = 0
    state[base + 4] = 0
    return count + 1


