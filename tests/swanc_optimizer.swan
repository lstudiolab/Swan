# Minimal executable correctness case for the Compiler 2 linear-IR optimizer.
# Dynamic lengths deliberately exercise heap-backed arrays, not stack-array
# lowering, so the test measures the optimizer rather than local-array codegen.

fn main() -> int:
    var instruction_words = 24
    var scratch_words = 4
    var diagnostic_words = 2
    let instructions = array_unchecked(instruction_words)
    let known = array_unchecked(scratch_words)
    let values = array_unchecked(scratch_words)
    let diagnostic = array_unchecked(diagnostic_words)
    instructions[0] = 0
    instructions[1] = 4
    instructions[2] = 1
    instructions[6] = 5
    instructions[8] = 0
    instructions[9] = 4
    instructions[10] = 2
    instructions[14] = 7
    instructions[16] = 1
    instructions[17] = 4
    instructions[18] = 3
    instructions[19] = 1
    instructions[20] = 2
    let status = swanc_ir_optimize(instructions, 3, known, values, 4, diagnostic)
    if status != 0:
        return 10 - diagnostic[0]
    return 0

out
