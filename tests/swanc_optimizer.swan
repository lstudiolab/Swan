# Minimal executable correctness case for the Compiler 2 linear-IR optimizer.

fn main() -> int:
    let instructions = array_unchecked(24)
    let known = array_unchecked(4)
    let values = array_unchecked(4)
    let diagnostic = array_unchecked(2)
    instructions[0] = 0
    instructions[1] = 4
    instructions[2] = 1
    instructions[6] = 5
    instructions[8] = 0
    instructions[9] = 4
    instructions[10] = 2
    instructions[14] = 7
    instructions[16] = 1
    instructions[17] = 4
    instructions[18] = 3
    instructions[19] = 1
    instructions[20] = 2
    if swanc_ir_optimize(instructions, 3, known, values, 4, diagnostic) != 0:
        return 1
    if instructions[16] != 0 or instructions[22] != 12:
        return 2
    return 0

out
