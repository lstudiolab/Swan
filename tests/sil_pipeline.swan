import silgen
import silverify
import siloptimization

fn main() -> int:
    let state = array_unchecked(1280)
    let live = array_unchecked(256)
    let keep = array_unchecked(256)
    let known = array_unchecked(256)
    let constants = array_unchecked(256)
    var count = sil_emit_const(state, 0, 1, 10, 1)
    count = sil_emit_const(state, count, 2, 20, 1)
    count = sil_emit_binary(state, count, 18, 3, 1, 2)
    count = sil_emit_return(state, count, 3)
    if sil_verify(state, count) == 0
        return 1
    count = sil_optimize(state, count, live, keep, known, constants)
    if count != 2
        return 2
    if state[0] != 17 or state[1] != 3 or state[4] != 30
        return 3
    if state[5] != 10 or state[7] != 3
        return 4
    return 0
