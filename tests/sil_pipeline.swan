import silgen
import siloptimization

fn main() -> int:
    let state = array_unchecked(1280)
    let workspace = array_unchecked(1024)
    var count = sil_emit_const(state, 0, 1 * 1048576 + 1 * 65536 + 10)
    count = sil_emit_const(state, count, 2 * 1048576 + 1 * 65536 + 20)
    count = sil_emit_binary(state, count, 18 * 16777216 + 3 * 65536 + 1 * 256 + 2)
    count = sil_emit_return(state, count, 3)
    if sil_verify(state, count) != 1
        echo!("SIL_VERIFY_FAILED")
        return 1
    count = sil_optimize(state, count, workspace)
    if count != 2
        echo!("SIL_OPTIMIZE_COUNT_FAILED")
        log count
        return 2
    if state[0] != 17 or state[1] != 3 or state[4] != 30
        echo!("SIL_FOLD_RESULT_FAILED")
        return 3
    if state[5] != 10 or state[7] != 3
        echo!("SIL_RETURN_FAILED")
        return 4
    echo!("SIL_PIPELINE_PASSED")
    return 0

