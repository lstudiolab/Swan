{
  "Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2}):",
      "    ${0:pass}"
    ],
    "description": "Declare an indentation-based Swan function"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name}:",
      "    var ${2:field} = ${3:value}"
    ],
    "description": "Declare a Swan structure"
  },
  "Variable": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${2:value}"
    ],
    "description": "Declare a mutable variable"
  },
  "Immutable value": {
    "prefix": "let",
    "body": [
      "let ${1:name} = ${2:value}"
    ],
    "description": "Declare an immutable variable"
  },
  "Constant": {
    "prefix": "const",
    "body": [
      "const ${1:NAME} = ${2:value}"
    ],
    "description": "Declare a constant"
  },
  "If statement": {
    "prefix": "if",
    "body": [
      "if ${1:condition}:",
      "    ${0:pass}"
    ],
    "description": "Create an if block"
  },
  "If else statement": {
    "prefix": "ife",
    "body": [
      "if ${1:condition}:",
      "    ${2:pass}",
      "else:",
      "    ${0:pass}"
    ],
    "description": "Create an if/else block"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items}:",
      "    ${0:pass}"
    ],
    "description": "Create a for loop"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition}:",
      "    ${0:pass}"
    ],
    "description": "Create a while loop"
  },
  "Print": {
    "prefix": "print",
    "body": [
      "print(\"${1:Hello, World!}\")"
    ],
    "description": "Print a value"
  },
  "Async function": {
    "prefix": "asyncfunc",
    "body": [
      "async func ${1:name}(${2}):",
      "    ${0:pass}"
    ],
    "description": "Declare an asynchronous function"
  },
  "Thread function": {
    "prefix": "threadfunc",
    "body": [
      "thread func ${1:name}(${2}):",
      "    ${0:pass}"
    ],
    "description": "Declare a thread function"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value}:",
      "    case ${2:pattern}:",
      "        ${0:pass}"
    ],
    "description": "Create a match block"
  }
}\n