{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\\\s*(fn\\\\b.*:|if\\\\b.*|else\\\\s*|while\\\\b.*)$",
    "decreaseIndentPattern": "^\\\\s*else\\\\s*$"
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
