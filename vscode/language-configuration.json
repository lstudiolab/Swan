{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:func|struct|enum|variant|protocol|namespace|if|else|while|for|loop|match|guard|thread|async)\\b.*|.*):\\s*$",
    "decreaseIndentPattern": "^\\\\s*else\\\\b.*:\\\\s*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:func|struct|enum|variant|protocol|namespace|if|else|while|for|loop|match|guard|thread|async)\\b.*:\\s*$",
      "action": {
        "indent": "indent"
      }
    }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
