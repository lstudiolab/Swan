{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Swan",
  "scopeName": "source.swan",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#control"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.swan",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.swan",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.swan",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.swan",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.swan",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.swan",
          "match": "\\b(true|false|null|nil)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "storage.type.function.swan",
          "match": "\\b(func|thread|async)\\b"
        },
        {
          "name": "storage.modifier.swan",
          "match": "\\b(let|var|const|external|lazy)\\b"
        },
        {
          "name": "keyword.other.swan",
          "match": "\\b(import|namespace|export|from|as|self|set)\\b"
        },
        {
          "name": "meta.variable.declaration.swan",
          "match": "\\\\b(let|var|const)\\\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.swan"
            },
            "2": {
              "name": "variable.other.readwrite.swan"
            }
          }
        },
        {
          "name": "meta.function.declaration.swan",
          "match": "\\\\b(func|thread|async)\\\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.swan"
            },
            "2": {
              "name": "entity.name.function.swan"
            }
          }
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.swan",
          "match": "\\b(if|else|while|for|in|loop|block|guard|defer|match|case|return|break|continue|pass)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.swan",
          "match": "\\b(bool|struct|enum|type|variant|protocol)\\b"
        },
        {
          "name": "meta.type.declaration.swan",
          "match": "\\\\b(struct|enum|type|variant|protocol)\\\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.swan"
            },
            "2": {
              "name": "entity.name.type.swan"
            }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.swan",
          "match": "\\bprint\\b(?=\\s*\\()"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.swan",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.member.swan",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.swan",
          "match": "->|==|!=|<=|>=|=|\\+|-|\\*|/|%|<|>|!|&&|\\|\\||\\b(and|or|not)\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.swan",
          "match": "[,:;.]"
        },
        {
          "name": "punctuation.section.brackets.swan",
          "match": "[()\\[\\]]"
        }
      ]
    }
  }
}
