{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Swan",
  "scopeName": "source.swan",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#control"
    },
    {
      "include": "#operations"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#types"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.swan",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.swan",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.swan",
              "match": "\\\\\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.swan",
          "match": "\\\\b[0-9]+\\\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "storage.type.function.swan",
          "match": "\\\\bfn\\\\b"
        },
        {
          "name": "storage.modifier.swan",
          "match": "\\\\b(import|let|var|const)\\\\b"
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.swan",
          "match": "\\\\b(if|else|while|break|continue|return|pass)\\\\b"
        }
      ]
    },
    "operations": {
      "patterns": [
        {
          "name": "support.function.builtin.swan",
          "match": "\\\\b(log|echo|array|array_unchecked|array_u32|array_u32_unchecked)\\\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.swan",
          "match": "\\\\b(true|false|none)\\\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.swan",
          "match": "->|==|!=|<=|>=|=|\\\\+|-|\\\\*|/|%|<|>|!|\\\\b(and|or|not)\\\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.swan",
          "match": "[,:;.]"
        },
        {
          "name": "punctuation.section.brackets.swan",
          "match": "[()\\\\[\\\\]]"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.swan",
          "match": "\\\\b(int|bool|string|void)\\\\b"
        },
        {
          "name": "entity.name.function.swan",
          "match": "\\\\b[A-Za-z_][A-Za-z0-9_]*(?=\\\\s*\\\\()"
        }
      ]
    }
  }
}
