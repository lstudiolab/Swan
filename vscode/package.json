{
  "name": "brew-language",
  "displayName": "Brew Language",
  "description": "Language support for Brew: syntax highlighting, snippets, and compiler tasks.",
  "version": "0.1.0",
  "publisher": "lstudiolab",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "brew",
    "programming-language",
    "syntax-highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lstudiolab/Brew.git",
    "directory": "vscode"
  },
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "brew",
        "aliases": ["Brew", "brew"],
        "extensions": [".brew"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "brew",
        "scopeName": "source.brew",
        "path": "./syntaxes/brew.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "brew",
        "path": "./snippets/brew.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0"
  }
}
