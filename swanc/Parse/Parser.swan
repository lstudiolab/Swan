# Pratt expression parser.
# AST records: kind, token-index, left-id, right-id, literal.
# Node IDs are one-based. This frontend slice accepts integer expressions.
#
# Token kinds are the stable Lexer.swan ABI:
# integer=2, newline=5, indent=6, dedent=7, '('=28, ')'=29,
# '+'=33, '-'=34, '*'=35, '/'=36, '%'=38, comparisons=40...45,
# EOF=0. Keep this table synchronized with Lexer.swan.

fn swanc_precedence(kind: int) -> int:
    # Multiplicative operators bind more tightly than additive operators.
    if kind == 35 or kind == 36 or kind == 38:
        return 3
    if kind == 33 or kind == 34:
        return 2
    if kind == 40 or kind == 41 or kind == 42 or kind == 43 or kind == 44 or kind == 45:
        return 1
    return 0

out
fn swanc_parse_primary(source: u32_array, tokens: u32_array, nodes: u32_array, state: u32_array) -> int:
    let token_count = state[2]
    let position = state[0]
    if position < 0 or position >= token_count:
        return -1
    let token_base = position * 5
    let kind = tokens[token_base]

    # The lexer emits integer literals as kind 2 and floating literals as 3.
    if kind == 2:
        let start = tokens[token_base + 1]
        let length = tokens[token_base + 2]
        var value = 0
        var i = 0
        while i < length:
            let digit = source[start + i] - 48
            if digit < 0 or digit > 9 or value > 429496729 or (value == 429496729 and digit > 5):
                return -2
            value = value * 10 + digit
            i = i + 1
        state[0] = position + 1
        let node_count = state[1]
        if node_count < 0 or node_count >= state[3]:
            return -1
        let node_base = node_count * 5
        nodes[node_base] = 1
        nodes[node_base + 1] = position
        nodes[node_base + 2] = 0
        nodes[node_base + 3] = 0
        nodes[node_base + 4] = value
        state[1] = node_count + 1
        return node_count + 1

    # Parenthesis token kinds are 28 and 29 in Lexer.swan.
    if kind == 28:
        state[0] = position + 1
        let inner = swanc_parse_expression(source, tokens, nodes, state, 1)
        if inner < 1 or state[0] >= token_count:
            return -3
        if tokens[state[0] * 5] != 29:
            return -3
        state[0] = state[0] + 1
        return inner
    return -5

out
fn swanc_parse_expression(source: u32_array, tokens: u32_array, nodes: u32_array, state: u32_array, minimum: int) -> int:
    let token_count = state[2]
    var left = swanc_parse_primary(source, tokens, nodes, state)
    if left < 1:
        return -1
    var running = 1
    while running == 1 and state[0] < token_count:
        let position = state[0]
        let kind = tokens[position * 5]
        let precedence = swanc_precedence(kind)
        if precedence < minimum:
            running = 0
        else:
            state[0] = position + 1
            let right = swanc_parse_expression(source, tokens, nodes, state, precedence + 1)
            if right < 1:
                return -2
            let node_count = state[1]
            if node_count < 0 or node_count >= state[3]:
                return -3
            let node_base = node_count * 5
            nodes[node_base] = 4
            nodes[node_base + 1] = position
            nodes[node_base + 2] = left
            nodes[node_base + 3] = right
            nodes[node_base + 4] = 0
            state[1] = node_count + 1
            left = node_count + 1
    return left

out
fn swanc_parse(source: u32_array, tokens: u32_array, nodes: u32_array, state: u32_array) -> int:
    let token_count = state[2]
    if token_count < 2 or state[3] < 1:
        return -1
    state[0] = 0
    state[1] = 0
    let root = swanc_parse_expression(source, tokens, nodes, state, 1)
    if root < 1:
        return -2

    # Newlines may follow the expression. The lexer terminates with EOF kind 0.
    while state[0] < token_count and tokens[state[0] * 5] == 5:
        state[0] = state[0] + 1
    if state[0] >= token_count or tokens[state[0] * 5] != 0:
        return -3
    return root

out
