# Swan Compiler 2 — Lexer

# Executable, allocation-conscious lexer core. The source is supplied as UTF-8
# bytes in u32_array (each element must be in 0...255). Tokens are emitted into
# caller-owned storage as five u32 words per token:
#   [kind, byte_offset, byte_length, start_line, start_column].
#
# Caller-owned workspace layout (at least 138 u32 words):
#   [0..3] diagnostics: error_code, byte_offset, line, column
#   [4] token capacity
#   [5..132] indentation stack (128 entries)
#   [133..137] reusable five-word token record.
# No heap allocation occurs in the lexer.
# A successful call returns the token count including EOF. A negative return
# is a lexical error. No partial token stream is considered valid on failure.
#
# Keyword spellings are hardcoded below. Matching is exact, case-sensitive,
# allocation-free, and performed only after scanning the complete identifier.
# The reserved set is exactly the 36 spellings in the Swan language contract.
# Legacy spellings such as fn and out are identifiers, never keyword tokens.

fn swanc_ascii_alpha(byte: int) -> bool:
    return (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)

out
fn swanc_ascii_digit(byte: int) -> bool:
    return byte >= 48 and byte <= 57

out
fn swanc_ident_start(byte: int) -> bool:
    return swanc_ascii_alpha(byte) or byte == 95 or byte >= 128

out
fn swanc_ident_continue(byte: int) -> bool:
    return swanc_ident_start(byte) or swanc_ascii_digit(byte)

out
fn swanc_utf8_width(source: u32_array, index: int, length: int) -> int:
    let first = source[index]
    if first < 128:
        return 1
    if first >= 194 and first <= 223:
        if index + 1 >= length:
            return 0
        if source[index + 1] < 128 or source[index + 1] > 191:
            return 0
        return 2
    if first >= 224 and first <= 239:
        if index + 2 >= length:
            return 0
        let second = source[index + 1]
        let third = source[index + 2]
        if second < 128 or second > 191 or third < 128 or third > 191:
            return 0
        if first == 224 and second < 160:
            return 0
        if first == 237 and second >= 160:
            return 0
        return 3
    if first >= 240 and first <= 244:
        if index + 3 >= length:
            return 0
        let second = source[index + 1]
        if second < 128 or second > 191:
            return 0
        if source[index + 2] < 128 or source[index + 2] > 191:
            return 0
        if source[index + 3] < 128 or source[index + 3] > 191:
            return 0
        if first == 240 and second < 144:
            return 0
        if first == 244 and second > 143:
            return 0
        return 4
    return 0

out
fn swanc_keyword(source: u32_array, start: int, length: int) -> int:
    # Exact 36-word Swan reserved set. Every other spelling is an identifier.
    if length == 4 and source[start + 0] == 102 and source[start + 1] == 117 and source[start + 2] == 110 and source[start + 3] == 99:
        return 8
    if length == 6 and source[start + 0] == 115 and source[start + 1] == 116 and source[start + 2] == 114 and source[start + 3] == 117 and source[start + 4] == 99 and source[start + 5] == 116:
        return 52
    if length == 6 and source[start + 0] == 105 and source[start + 1] == 109 and source[start + 2] == 112 and source[start + 3] == 111 and source[start + 4] == 114 and source[start + 5] == 116:
        return 9
    if length == 6 and source[start + 0] == 101 and source[start + 1] == 120 and source[start + 2] == 112 and source[start + 3] == 111 and source[start + 4] == 114 and source[start + 5] == 116:
        return 62
    if length == 4 and source[start + 0] == 101 and source[start + 1] == 110 and source[start + 2] == 117 and source[start + 3] == 109:
        return 53
    if length == 3 and source[start + 0] == 108 and source[start + 1] == 101 and source[start + 2] == 116:
        return 11
    if length == 3 and source[start + 0] == 118 and source[start + 1] == 97 and source[start + 2] == 114:
        return 12
    if length == 5 and source[start + 0] == 99 and source[start + 1] == 111 and source[start + 2] == 110 and source[start + 3] == 115 and source[start + 4] == 116:
        return 13
    if length == 2 and source[start + 0] == 105 and source[start + 1] == 102:
        return 15
    if length == 4 and source[start + 0] == 101 and source[start + 1] == 108 and source[start + 2] == 115 and source[start + 3] == 101:
        return 16
    if length == 5 and source[start + 0] == 119 and source[start + 1] == 104 and source[start + 2] == 105 and source[start + 3] == 108 and source[start + 4] == 101:
        return 17
    if length == 4 and source[start + 0] == 108 and source[start + 1] == 111 and source[start + 2] == 111 and source[start + 3] == 112:
        return 57
    if length == 4 and source[start + 0] == 116 and source[start + 1] == 114 and source[start + 2] == 117 and source[start + 3] == 101:
        return 21
    if length == 5 and source[start + 0] == 102 and source[start + 1] == 97 and source[start + 2] == 108 and source[start + 3] == 115 and source[start + 4] == 101:
        return 22
    if length == 5 and source[start + 0] == 103 and source[start + 1] == 117 and source[start + 2] == 97 and source[start + 3] == 114 and source[start + 4] == 100:
        return 59
    if length == 5 and source[start + 0] == 100 and source[start + 1] == 101 and source[start + 2] == 102 and source[start + 3] == 101 and source[start + 4] == 114:
        return 81
    if length == 6 and source[start + 0] == 114 and source[start + 1] == 101 and source[start + 2] == 116 and source[start + 3] == 117 and source[start + 4] == 114 and source[start + 5] == 110:
        return 14
    if length == 5 and source[start + 0] == 98 and source[start + 1] == 114 and source[start + 2] == 101 and source[start + 3] == 97 and source[start + 4] == 107:
        return 18
    if length == 8 and source[start + 0] == 99 and source[start + 1] == 111 and source[start + 2] == 110 and source[start + 3] == 116 and source[start + 4] == 105 and source[start + 5] == 110 and source[start + 6] == 117 and source[start + 7] == 101:
        return 19
    if length == 5 and source[start + 0] == 98 and source[start + 1] == 108 and source[start + 2] == 111 and source[start + 3] == 99 and source[start + 4] == 107:
        return 77
    if length == 2 and source[start + 0] == 97 and source[start + 1] == 115:
        return 61
    if length == 4 and source[start + 0] == 98 and source[start + 1] == 111 and source[start + 2] == 111 and source[start + 3] == 108:
        return 79
    if length == 4 and source[start + 0] == 102 and source[start + 1] == 114 and source[start + 2] == 111 and source[start + 3] == 109:
        return 60
    if length == 4 and source[start + 0] == 117 and source[start + 1] == 112 and source[start + 2] == 116 and source[start + 3] == 111:
        return 55
    if length == 6 and source[start + 0] == 105 and source[start + 1] == 110 and source[start + 2] == 108 and source[start + 3] == 105 and source[start + 4] == 110 and source[start + 5] == 101:
        return 64
    if length == 6 and source[start + 0] == 115 and source[start + 1] == 116 and source[start + 2] == 97 and source[start + 3] == 116 and source[start + 4] == 105 and source[start + 5] == 99:
        return 70
    if length == 7 and source[start + 0] == 112 and source[start + 1] == 114 and source[start + 2] == 105 and source[start + 3] == 118 and source[start + 4] == 97 and source[start + 5] == 116 and source[start + 6] == 101:
        return 72
    if length == 6 and source[start + 0] == 112 and source[start + 1] == 117 and source[start + 2] == 98 and source[start + 3] == 108 and source[start + 4] == 105 and source[start + 5] == 99:
        return 73
    if length == 5 and source[start + 0] == 109 and source[start + 1] == 97 and source[start + 2] == 116 and source[start + 3] == 99 and source[start + 4] == 104:
        return 58
    if length == 3 and source[start + 0] == 109 and source[start + 1] == 111 and source[start + 2] == 100:
        return 74
    if length == 2 and source[start + 0] == 105 and source[start + 1] == 110:
        return 56
    if length == 3 and source[start + 0] == 105 and source[start + 1] == 110 and source[start + 2] == 116:
        return 54
    if length == 4 and source[start + 0] == 105 and source[start + 1] == 110 and source[start + 2] == 105 and source[start + 3] == 116:
        return 75
    if length == 6 and source[start + 0] == 100 and source[start + 1] == 101 and source[start + 2] == 105 and source[start + 3] == 110 and source[start + 4] == 105 and source[start + 5] == 116:
        return 76
    if length == 4 and source[start + 0] == 115 and source[start + 1] == 101 and source[start + 2] == 108 and source[start + 3] == 102:
        return 63
    if length == 4 and source[start + 0] == 112 and source[start + 1] == 97 and source[start + 2] == 115 and source[start + 3] == 115:
        return 20
    return 1

out
fn swanc_emit(tokens: u32_array, capacity: int, count: int, workspace: u32_array) -> int:
    if count >= capacity:
        return 0 - 1
    let base = count * 5
    tokens[base] = workspace[133]
    tokens[base + 1] = workspace[134]
    tokens[base + 2] = workspace[135]
    tokens[base + 3] = workspace[136]
    tokens[base + 4] = workspace[137]
    return count + 1

out
fn swanc_fail(diagnostic: u32_array, code: int, offset: int, line: int, column: int) -> int:
    diagnostic[0] = code
    diagnostic[1] = offset
    diagnostic[2] = line
    diagnostic[3] = column
    return 0 - code

out
fn swan_lex(source: u32_array, source_length: int, tokens: u32_array, diagnostic: u32_array) -> int:
    let token_capacity = diagnostic[4]
    diagnostic[0] = 91
    # Token IDs are the stable Compiler 2 lexer ABI; keyword IDs are explicit below.
    # Diagnostic codes: 1 invalid UTF-8, 2 invalid byte, 3 token capacity,
    # 4 indentation depth, 5 inconsistent indentation, 6 malformed number,
    # 7 unterminated/invalid string, 8 invalid escape, 9 invalid source size.
    if source_length < 0 or token_capacity < 1:
        return swanc_fail(diagnostic, 9, 0, 1, 1)
    var index = 0
    var line = 1
    var column = 1
    var count = 0
    var line_start = 1
    var indent_depth = 1
    diagnostic[5] = 0
    diagnostic[0] = 0
    diagnostic[1] = 0
    diagnostic[2] = 0
    diagnostic[3] = 0
    diagnostic[0] = 92
    # Validate all input before scanning; malformed UTF-8 is rejected even
    # when it occurs in comments or string literals.
    var validation_line = 1
    var validation_column = 1
    diagnostic[0] = 94
    while index < source_length:
        diagnostic[0] = 95
        if source[index] < 0 or source[index] > 255:
            return swanc_fail(diagnostic, 2, index, validation_line, validation_column)
        var width = 1
        if source[index] >= 128:
            width = swanc_utf8_width(source, index, source_length)
        diagnostic[0] = 96
        if width == 0:
            return swanc_fail(diagnostic, 1, index, validation_line, validation_column)
        if width == 1 and source[index] == 10:
            validation_line = validation_line + 1
            validation_column = 1
        else:
            validation_column = validation_column + 1
        index = index + width
    diagnostic[0] = 93
    index = 0
    # A UTF-8 BOM is accepted only at the beginning of the file.
    if source_length >= 3 and source[0] == 239 and source[1] == 187 and source[2] == 191:
        index = 3
    diagnostic[0] = 94
    while index < source_length:
        if line_start == 1:
            var indent_width = 0
            while index < source_length and (source[index] == 32 or source[index] == 9):
                if source[index] == 9:
                    indent_width = indent_width + 4
                else:
                    indent_width = indent_width + 1
                index = index + 1
                column = column + 1
            if index >= source_length:
                break
            if source[index] == 10 or source[index] == 35:
                while index < source_length and source[index] != 10:
                    let comment_width = swanc_utf8_width(source, index, source_length)
                    index = index + comment_width
                    column = column + 1
                if index < source_length:
                    index = index + 1
                    line = line + 1
                    column = 1
                continue
            line_start = 0
            if indent_width > diagnostic[5 + indent_depth - 1]:
                if indent_depth >= 128:
                    return swanc_fail(diagnostic, 4, index, line, column)
                diagnostic[5 + indent_depth] = indent_width
                indent_depth = indent_depth + 1
                diagnostic[133] = 6
                diagnostic[134] = index
                diagnostic[135] = 0
                diagnostic[136] = line
                diagnostic[137] = column
                count = swanc_emit(tokens, token_capacity, count, diagnostic)
                if count < 0:
                    return swanc_fail(diagnostic, 3, index, line, column)
            else:
                if indent_width < diagnostic[5 + indent_depth - 1]:
                    while indent_depth > 1 and indent_width < diagnostic[5 + indent_depth - 1]:
                        indent_depth = indent_depth - 1
                        diagnostic[133] = 7
                        diagnostic[134] = index
                        diagnostic[135] = 0
                        diagnostic[136] = line
                        diagnostic[137] = column
                        count = swanc_emit(tokens, token_capacity, count, diagnostic)
                        if count < 0:
                            return swanc_fail(diagnostic, 3, index, line, column)
                    if indent_width != diagnostic[5 + indent_depth - 1]:
                        return swanc_fail(diagnostic, 5, index, line, column)
        let byte = source[index]
        if byte == 32 or byte == 9 or byte == 13:
            index = index + 1
            column = column + 1
            continue
        if byte == 35:
            while index < source_length and source[index] != 10:
                let comment_width = swanc_utf8_width(source, index, source_length)
                index = index + comment_width
                column = column + 1
            continue
        if byte == 10:
            diagnostic[133] = 5
            diagnostic[134] = index
            diagnostic[135] = 0
            diagnostic[136] = line
            diagnostic[137] = column
            count = swanc_emit(tokens, token_capacity, count, diagnostic)
            if count < 0:
                return swanc_fail(diagnostic, 3, index, line, column)
            index = index + 1
            line = line + 1
            column = 1
            line_start = 1
            continue
        let token_start = index
        let token_line = line
        let token_column = column
        if swanc_ident_start(byte):
            while index < source_length and swanc_ident_continue(source[index]):
                let width = swanc_utf8_width(source, index, source_length)
                if width == 0:
                    return swanc_fail(diagnostic, 1, index, line, column)
                index = index + width
                column = column + 1
            let token_length = index - token_start
            let kind = swanc_keyword(source, token_start, token_length)
            diagnostic[133] = kind
            diagnostic[134] = token_start
            diagnostic[135] = token_length
            diagnostic[136] = token_line
            diagnostic[137] = token_column
            count = swanc_emit(tokens, token_capacity, count, diagnostic)
            if count < 0:
                return swanc_fail(diagnostic, 3, token_start, token_line, token_column)
            continue
        if swanc_ascii_digit(byte):
            while index < source_length and swanc_ascii_digit(source[index]):
                index = index + 1
                column = column + 1
            var kind = 2
            if index < source_length and source[index] == 46 and index + 1 < source_length and swanc_ascii_digit(source[index + 1]):
                kind = 3
                index = index + 1
                column = column + 1
                while index < source_length and swanc_ascii_digit(source[index]):
                    index = index + 1
                    column = column + 1
            if index < source_length and swanc_ident_start(source[index]):
                return swanc_fail(diagnostic, 6, index, line, column)
            diagnostic[133] = kind
            diagnostic[134] = token_start
            diagnostic[135] = index - token_start
            diagnostic[136] = token_line
            diagnostic[137] = token_column
            count = swanc_emit(tokens, token_capacity, count, diagnostic)
            if count < 0:
                return swanc_fail(diagnostic, 3, token_start, token_line, token_column)
            continue
        if byte == 34 or byte == 39:
            let quote = byte
            index = index + 1
            column = column + 1
            var closed = 0
            while index < source_length:
                let current = source[index]
                if current == quote:
                    index = index + 1
                    column = column + 1
                    closed = 1
                    break
                if current == 10 or current == 13:
                    return swanc_fail(diagnostic, 7, token_start, token_line, token_column)
                if current == 92:
                    index = index + 1
                    column = column + 1
                    if index >= source_length:
                        return swanc_fail(diagnostic, 7, token_start, token_line, token_column)
                    let escaped = source[index]
                    if escaped != 110 and escaped != 114 and escaped != 116 and escaped != 92 and escaped != 34 and escaped != 39:
                        return swanc_fail(diagnostic, 8, index, line, column)
                let width = swanc_utf8_width(source, index, source_length)
                if width == 0:
                    return swanc_fail(diagnostic, 1, index, line, column)
                index = index + width
                column = column + 1
            if closed == 0:
                return swanc_fail(diagnostic, 7, token_start, token_line, token_column)
            diagnostic[133] = 4
            diagnostic[134] = token_start
            diagnostic[135] = index - token_start
            diagnostic[136] = token_line
            diagnostic[137] = token_column
            count = swanc_emit(tokens, token_capacity, count, diagnostic)
            if count < 0:
                return swanc_fail(diagnostic, 3, token_start, token_line, token_column)
            continue
        var kind = 0
        var width = 1
        if index + 1 < source_length:
            let next = source[index + 1]
            if byte == 45 and next == 62:
                kind = 32
                width = 2
            if byte == 47 and next == 47:
                kind = 37
                width = 2
            if byte == 61 and next == 61:
                kind = 40
                width = 2
            if byte == 33 and next == 61:
                kind = 41
                width = 2
            if byte == 60 and next == 61:
                kind = 44
                width = 2
            if byte == 62 and next == 61:
                kind = 45
                width = 2
        if kind == 0:
            if byte == 40:
                kind = 28
            if byte == 41:
                kind = 29
            if byte == 58:
                kind = 30
            if byte == 44:
                kind = 31
            if byte == 43:
                kind = 33
            if byte == 45:
                kind = 34
            if byte == 42:
                kind = 35
            if byte == 47:
                kind = 36
            if byte == 37:
                kind = 38
            if byte == 61:
                kind = 39
            if byte == 33:
                kind = 27
            if byte == 60:
                kind = 42
            if byte == 62:
                kind = 43
            if byte == 91:
                kind = 46
            if byte == 93:
                kind = 47
            if byte == 46:
                kind = 48
            if byte == 59:
                kind = 49
        if kind == 0:
            return swanc_fail(diagnostic, 2, index, line, column)
        diagnostic[133] = kind
        diagnostic[134] = index
        diagnostic[135] = width
        diagnostic[136] = token_line
        diagnostic[137] = token_column
        count = swanc_emit(tokens, token_capacity, count, diagnostic)
        if count < 0:
            return swanc_fail(diagnostic, 3, index, line, column)
        index = index + width
        column = column + width
    while indent_depth > 1:
        indent_depth = indent_depth - 1
        diagnostic[133] = 7
        diagnostic[134] = source_length
        diagnostic[135] = 0
        diagnostic[136] = line
        diagnostic[137] = column
        count = swanc_emit(tokens, token_capacity, count, diagnostic)
        if count < 0:
            return swanc_fail(diagnostic, 3, source_length, line, column)
    diagnostic[133] = 0
    diagnostic[134] = source_length
    diagnostic[135] = 0
    diagnostic[136] = line
    diagnostic[137] = column
    count = swanc_emit(tokens, token_capacity, count, diagnostic)
    if count < 0:
        return swanc_fail(diagnostic, 3, source_length, line, column)
    diagnostic[0] = 0
    return count

out
