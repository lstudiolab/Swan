# Swan Compiler 2 — scalar constant folding
#
# Workspace layout:
#   [0..1]                 verifier diagnostics
#   [2..capacity+1]        known-constant flags
#   [capacity+2..2*capacity+1] constant values
#
# Operates on the eight-word linear IR instruction format. It folds i32
# add/subtract/multiply when both operands are known constants. Multiplication
# is bounded to 16-bit operands so its intermediate cannot overflow. Result
# IDs remain stable; overflowing unsigned i32 results are left unchanged.

fn swanc_ir_constant_fold(instructions: u32_array, instruction_count: int, workspace: u32_array, capacity: int) -> int:
    if instruction_count < 0 or instruction_count > 268435455 or capacity < instruction_count + 1 or capacity > 268435455:
        return -1
    var index = 0
    while index < capacity:
        workspace[index + 2] = 0
        workspace[capacity + index + 2] = 0
        index = index + 1
    index = 0
    while index < instruction_count:
        let base = index * 8
        let opcode = instructions[base]
        let type_id = instructions[base + 1]
        let result_id = instructions[base + 2]
        let a = instructions[base + 3]
        let b = instructions[base + 4]
        if opcode == 0:
            if type_id == 4:
                if result_id < 1 or result_id >= capacity:
                    return -2
                workspace[result_id + 2] = 1
                workspace[capacity + result_id + 2] = instructions[base + 6]
        else
            if (opcode == 1 or opcode == 2 or opcode == 3) and type_id == 4:
                if result_id < 1 or result_id >= capacity:
                    return -2
                if a < 1 or b < 1 or a >= capacity or b >= capacity:
                    return -3
                if workspace[a + 2] == 1 and workspace[b + 2] == 1:
                    let left = workspace[capacity + a + 2]
                    let right = workspace[capacity + b + 2]
                    var folded = 0
                    var can_fold = true
                    if opcode == 1:
                        if left <= 4294967295 - right:
                            folded = left + right
                        else
                            can_fold = false
                    else
                        if opcode == 2:
                            if left >= right:
                                folded = left - right
                            else
                                can_fold = false
                        else
                            if left == 0:
                                folded = 0
                            else
                                if right == 0:
                                    folded = 0
                                else
                                    if left == 1:
                                        folded = right
                                    else
                                        if right == 1:
                                            folded = left
                                        else
                                            if left <= 65535 and right <= 65535:
                                                folded = left * right
                                            else
                                                can_fold = false
                    if can_fold and folded >= 0 and folded <= 4294967295:
                        instructions[base] = 0
                        instructions[base + 3] = 0
                        instructions[base + 4] = 0
                        instructions[base + 5] = 0
                        instructions[base + 6] = folded
                        instructions[base + 7] = 0
                        workspace[result_id + 2] = 1
                        workspace[capacity + result_id + 2] = folded
        index = index + 1
    return 0

out
