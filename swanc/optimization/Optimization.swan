# Swan Compiler 2 — verified linear IR optimization pipeline.
#
# Workspace layout is shared by every pass: two diagnostic words, followed by
# constant-state and constant-value arrays. The compact four-argument API also
# avoids the current x86-64 backend's six-argument register-allocation defect.

fn swanc_ir_optimize(instructions: u32_array, instruction_count: int, workspace: u32_array, capacity: int) -> int:
    if instruction_count < 0 or instruction_count > 268435455 or capacity < instruction_count + 1 or capacity > 268435455:
        workspace[0] = 13
        workspace[1] = 0
        return -5
    if swanc_ir_verify(instructions, instruction_count, 0, workspace) != 0:
        return -1
    if swanc_ir_constant_fold(instructions, instruction_count, workspace, capacity) != 0:
        workspace[0] = 11
        workspace[1] = 0
        return -2
    if swanc_ir_dead_code_eliminate(instructions, instruction_count, workspace, capacity) != 0:
        workspace[0] = 12
        workspace[1] = 0
        return -3
    if swanc_ir_verify(instructions, instruction_count, 0, workspace) != 0:
        return -4
    return 0

out
