# Swan Compiler 2 — linear IR optimization pipeline
#
# The pass manager accepts only verified input, runs each enabled pass, and
# verifies the representation again before returning it to the next stage.
# This initial pipeline is intentionally small: the linear IR currently has
# no CFG, so CFG-dependent passes are not enabled here.

fn swanc_ir_optimize(instructions: u32_array, instruction_count: int, known: u32_array, values: u32_array, capacity: int, diagnostic: u32_array) -> int:
    if swanc_ir_verify(instructions, instruction_count, 0, diagnostic) != 0:
        return -1
    if swanc_ir_constant_fold(instructions, instruction_count, parameter_count, known, values, capacity) != 0:
        diagnostic[0] = 11
        diagnostic[1] = 0
        return -2
    if swanc_ir_verify(instructions, instruction_count, parameter_count, diagnostic) != 0:
        return -3
    return 0

out
