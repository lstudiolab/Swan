# Swan Compiler 2 — conservative dead-code elimination for linear IR.
#
# Only non-trapping, side-effect-free value instructions are removable.
# Calls, loads, stores, divisions/remainders, allocas, and PHIs are retained.
# Removed definitions are replaced by zero constants to preserve stable SSA IDs
# until the IR gains block-aware instruction deletion and value renumbering.

fn swanc_ir_dead_code_eliminate(instructions: u32_array, instruction_count: int, workspace: u32_array, capacity: int) -> int:
    if instruction_count < 0 or instruction_count > 268435455 or capacity < instruction_count + 1 or capacity > 268435455:
        return -1
    if swanc_ir_compute_use_counts(instructions, instruction_count, workspace, capacity) != 0:
        return -1
    var index = instruction_count - 1
    while index >= 0:
        let base = index * 8
        let opcode = instructions[base]
        let result_id = instructions[base + 2]
        let a = instructions[base + 3]
        let b = instructions[base + 4]
        let c = instructions[base + 5]
        let pure = (opcode >= 1 and opcode <= 3) or (opcode >= 8 and opcode <= 20)
        if pure and result_id > 0 and result_id < capacity:
            if workspace[capacity * 2 + result_id + 2] == 0:
                instructions[base] = 0
                instructions[base + 3] = 0
                instructions[base + 4] = 0
                instructions[base + 5] = 0
                instructions[base + 6] = 0
                instructions[base + 7] = 0
                if (opcode >= 1 and opcode <= 19):
                    if a > 0 and a < capacity:
                        workspace[capacity * 2 + a + 2] = workspace[capacity * 2 + a + 2] - 1
                    if b > 0 and b < capacity:
                        workspace[capacity * 2 + b + 2] = workspace[capacity * 2 + b + 2] - 1
                else
                    if opcode == 20:
                        if a > 0 and a < capacity:
                            workspace[capacity * 2 + a + 2] = workspace[capacity * 2 + a + 2] - 1
                        if b > 0 and b < capacity:
                            workspace[capacity * 2 + b + 2] = workspace[capacity * 2 + b + 2] - 1
                        if c > 0 and c < capacity:
                            workspace[capacity * 2 + c + 2] = workspace[capacity * 2 + c + 2] - 1
        index = index - 1
    return 0

out
