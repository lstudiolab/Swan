# Swan Compiler 2 — linear IR use-count analysis.
#
# Workspace segment:
#   [2*capacity+2 .. 3*capacity+1] = number of uses for each SSA value ID.
# The verifier must run before this analysis so operand IDs are structurally valid.

fn swanc_ir_compute_use_counts(instructions: u32_array, instruction_count: int, workspace: u32_array, capacity: int) -> int:
    if instruction_count < 0 or instruction_count > 268435455 or capacity < instruction_count + 1 or capacity > 268435455:
        return -1
    var index = 0
    while index < capacity:
        workspace[capacity * 2 + index + 2] = 0
        index = index + 1
    index = 0
    while index < instruction_count:
        let base = index * 8
        let opcode = instructions[base]
        let a = instructions[base + 3]
        let b = instructions[base + 4]
        let c = instructions[base + 5]
        if (opcode >= 1 and opcode <= 19) or opcode == 24:
            if a > 0 and a < capacity:
                workspace[capacity * 2 + a + 2] = workspace[capacity * 2 + a + 2] + 1
            if b > 0 and b < capacity:
                workspace[capacity * 2 + b + 2] = workspace[capacity * 2 + b + 2] + 1
        else
            if opcode == 20 or opcode == 21 or opcode == 25:
                if a > 0 and a < capacity:
                    workspace[capacity * 2 + a + 2] = workspace[capacity * 2 + a + 2] + 1
                if b > 0 and b < capacity:
                    workspace[capacity * 2 + b + 2] = workspace[capacity * 2 + b + 2] + 1
                if c > 0 and c < capacity:
                    workspace[capacity * 2 + c + 2] = workspace[capacity * 2 + c + 2] + 1
            else
                if opcode == 23 and a > 0 and a < capacity:
                    workspace[capacity * 2 + a + 2] = workspace[capacity * 2 + a + 2] + 1
        index = index + 1
    return 0

out
