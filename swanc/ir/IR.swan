# Swan Compiler 2 — target-independent typed IR
#
# Instruction records occupy eight u32 words:
# [opcode, type, result, operand_a, operand_b, operand_c, immediate_low, immediate_high]
# Value IDs are one-based and definitions are emitted before their uses in this
# initial linear IR form. CFG blocks and PHI edges are layered on this format later.
#
# Types: 0 void, 1 i1, 2 i8, 3 i16, 4 i32, 5 i64, 6 f32, 7 f64, 8 ptr.
# Opcodes: 0 const, 1 add, 2 sub, 3 mul, 4 sdiv, 5 udiv, 6 srem, 7 urem,
# 8 and, 9 or, 10 xor, 11 shl, 12 lshr, 13 ashr, 14 eq, 15 ne,
# 16 slt, 17 sle, 18 sgt, 19 sge, 20 select, 21 phi, 22 alloca,
# 23 load, 24 store, 25 call.

fn swanc_ir_type_valid(type_id: int) -> bool:
    return type_id >= 0 and type_id <= 8

out
fn swanc_ir_value_type(type_id: int) -> bool:
    return type_id > 0 and type_id <= 8

out
fn swanc_ir_width(type_id: int) -> int:
    if type_id == 1 or type_id == 2:
        return 8
    if type_id == 3:
        return 16
    if type_id == 4 or type_id == 6:
        return 32
    if type_id == 5 or type_id == 7 or type_id == 8:
        return 64
    return 0

out
fn swanc_ir_emit(instructions: u32_array, capacity: int, state: u32_array, record: u32_array) -> int:
    let count = state[0]
    if count < 0 or count >= capacity or capacity > 268435455:
        state[2] = 1
        return -1
    let opcode = record[0]
    let type_id = record[1]
    if opcode < 0 or opcode > 25 or type_id < 0 or type_id > 8 or record[2] < 0 or record[3] < 0 or record[4] < 0:
        state[2] = 2
        return -2
    let base = count * 8
    var result_id = 0
    if type_id != 0:
        result_id = state[1]
        if result_id < 1 or result_id >= 2147483647:
            state[2] = 3
            return -3
        state[1] = result_id + 1
    instructions[base] = opcode
    instructions[base + 1] = type_id
    instructions[base + 2] = result_id
    instructions[base + 3] = record[2]
    instructions[base + 4] = record[3]
    instructions[base + 5] = record[4]
    instructions[base + 6] = record[5]
    instructions[base + 7] = record[6]
    state[0] = count + 1
    return result_id

out
fn swanc_ir_defined_before(instructions: u32_array, instruction_index: int, value_id: int) -> bool:
    if value_id < 1:
        return false
    var index = 0
    while index < instruction_index:
        if instructions[index * 8 + 2] == value_id:
            return true
        index = index + 1
    return false

out
fn swanc_ir_verify(instructions: u32_array, instruction_count: int, parameter_count: int, workspace: u32_array) -> int:
    if instruction_count < 0 or parameter_count < 0 or instruction_count > 268435455:
        workspace[0] = 1
        workspace[1] = 0
        return -1
    if parameter_count > 2147483646 - instruction_count:
        workspace[0] = 1
        workspace[1] = 0
        return -1
    let capacity = instruction_count + 1
    workspace[2] = parameter_count
    var slot = 0
    while slot < instruction_count:
        workspace[capacity + slot + 2] = 0
        slot = slot + 1
    var index = 0
    var expected_result = parameter_count + 1
    while index < instruction_count:
        let base = index * 8
        let opcode = instructions[base]
        let type_id = instructions[base + 1]
        let result_id = instructions[base + 2]
        let a = instructions[base + 3]
        let b = instructions[base + 4]
        let c = instructions[base + 5]
        if opcode < 0 or opcode > 25 or type_id < 0 or type_id > 8 or result_id < 0:
            workspace[0] = 2
            workspace[1] = index
            return -2
        if type_id == 0:
            if result_id != 0:
                workspace[0] = 3
                workspace[1] = index
                return -3
        else:
            if result_id != expected_result:
                workspace[0] = 4
                workspace[1] = index
                return -4
        if opcode == 0:
            if type_id == 0 or type_id == 8 or a != 0 or b != 0 or c != 0:
                workspace[0] = 5
                workspace[1] = index
                return -5
        else:
            if opcode >= 1 and opcode <= 13:
                if type_id < 1 or type_id > 5 or a < 1 or b < 1 or c != 0:
                    workspace[0] = 10
                    workspace[1] = index
                    return -10
                var type_a = -1
                if a >= 1 and a < expected_result:
                    if a <= parameter_count:
                        type_a = 0
                    else:
                        type_a = workspace[capacity + a - parameter_count + 1]
                var type_b = -1
                if b >= 1 and b < expected_result:
                    if b <= parameter_count:
                        type_b = 0
                    else:
                        type_b = workspace[capacity + b - parameter_count + 1]
                if type_a < 0 or type_b < 0:
                    workspace[0] = 13
                    workspace[1] = index
                    return -13
                if (type_a != 0 and type_a != type_id) or (type_b != 0 and type_b != type_id):
                    workspace[0] = 14
                    workspace[1] = index
                    return -14
            else:
                if opcode >= 14 and opcode <= 19:
                    if type_id != 1 or a < 1 or b < 1 or c != 0:
                        workspace[0] = 10
                        workspace[1] = index
                        return -10
                    var type_a = -1
                    if a >= 1 and a < expected_result:
                        if a <= parameter_count:
                            type_a = 0
                        else:
                            type_a = workspace[capacity + a - parameter_count + 1]
                    var type_b = -1
                    if b >= 1 and b < expected_result:
                        if b <= parameter_count:
                            type_b = 0
                        else:
                            type_b = workspace[capacity + b - parameter_count + 1]
                    if type_a < 0 or type_b < 0:
                        workspace[0] = 13
                        workspace[1] = index
                        return -13
                    if (type_a != 0 and (type_a < 1 or type_a > 5)) or (type_b != 0 and (type_b < 1 or type_b > 5)):
                        workspace[0] = 14
                        workspace[1] = index
                        return -14
                    if type_a != 0 and type_b != 0 and type_a != type_b:
                        workspace[0] = 14
                        workspace[1] = index
                        return -14
                else:
                    if opcode == 20:
                        if type_id == 0 or a < 1 or b < 1 or c < 1:
                            workspace[0] = 9
                            workspace[1] = index
                            return -9
                        var type_a = -1
                        if a >= 1 and a < expected_result:
                            if a <= parameter_count:
                                type_a = 0
                            else:
                                type_a = workspace[capacity + a - parameter_count + 1]
                        var type_b = -1
                        if b >= 1 and b < expected_result:
                            if b <= parameter_count:
                                type_b = 0
                            else:
                                type_b = workspace[capacity + b - parameter_count + 1]
                        var type_c = -1
                        if c >= 1 and c < expected_result:
                            if c <= parameter_count:
                                type_c = 0
                            else:
                                type_c = workspace[capacity + c - parameter_count + 1]
                        if type_a < 0 or type_b < 0 or type_c < 0:
                            workspace[0] = 13
                            workspace[1] = index
                            return -13
                        if (type_a != 0 and type_a != 1) or (type_b != 0 and type_b != type_id) or (type_c != 0 and type_c != type_id):
                            workspace[0] = 14
                            workspace[1] = index
                            return -14
                    else:
                        if opcode == 21:
                            if type_id == 0 or a < 1 or b < 1 or (b == 0 and c != 0):
                                workspace[0] = 15
                                workspace[1] = index
                                return -15
                            var type_a = -1
                            if a >= 1 and a < expected_result:
                                if a <= parameter_count:
                                    type_a = 0
                                else:
                                    type_a = workspace[capacity + a - parameter_count + 1]
                            var type_b = -1
                            if b >= 1 and b < expected_result:
                                if b <= parameter_count:
                                    type_b = 0
                                else:
                                    type_b = workspace[capacity + b - parameter_count + 1]
                            var type_c = 0
                            if c != 0:
                                if c >= 1 and c < expected_result:
                                    if c <= parameter_count:
                                        type_c = 0
                                    else:
                                        type_c = workspace[capacity + c - parameter_count + 1]
                            if type_a < 0 or type_b < 0 or type_c < 0:
                                workspace[0] = 13
                                workspace[1] = index
                                return -13
                            if (type_a != 0 and type_a != type_id) or (type_b != 0 and type_b != type_id) or (c != 0 and type_c != 0 and type_c != type_id):
                                workspace[0] = 14
                                workspace[1] = index
                                return -14
                        else:
                            if opcode == 22:
                                if type_id != 8 or a != 0 or b != 0 or c != 0:
                                    workspace[0] = 6
                                    workspace[1] = index
                                    return -6
                            else:
                                if opcode == 23:
                                    if type_id == 0 or a < 1 or b != 0 or c != 0:
                                        workspace[0] = 7
                                        workspace[1] = index
                                        return -7
                                    var pointer_type = -1
                                    if a >= 1 and a < expected_result:
                                        if a <= parameter_count:
                                            pointer_type = 0
                                        else:
                                            pointer_type = workspace[capacity + a - parameter_count + 1]
                                    if pointer_type < 0:
                                        workspace[0] = 13
                                        workspace[1] = index
                                        return -13
                                    if pointer_type != 0 and pointer_type != 8:
                                        workspace[0] = 14
                                        workspace[1] = index
                                        return -14
                                else:
                                    if opcode == 24:
                                        if type_id != 0 or a < 1 or b < 1 or c != 0:
                                            workspace[0] = 8
                                            workspace[1] = index
                                            return -8
                                        var pointer_type = -1
                                        if a >= 1 and a < expected_result:
                                            if a <= parameter_count:
                                                pointer_type = 0
                                            else:
                                                pointer_type = workspace[capacity + a - parameter_count + 1]
                                        var value_type = -1
                                        if b >= 1 and b < expected_result:
                                            if b <= parameter_count:
                                                value_type = 0
                                            else:
                                                value_type = workspace[capacity + b - parameter_count + 1]
                                        if pointer_type < 0 or value_type < 0:
                                            workspace[0] = 13
                                            workspace[1] = index
                                            return -13
                                        if pointer_type != 0 and pointer_type != 8:
                                            workspace[0] = 14
                                            workspace[1] = index
                                            return -14
                                    else:
                                        if opcode == 25:
                                            if (a == 0 and (b != 0 or c != 0)) or (b == 0 and c != 0):
                                                workspace[0] = 16
                                                workspace[1] = index
                                                return -16
                                            if a != 0 and (a < 1 or a >= expected_result):
                                                workspace[0] = 13
                                                workspace[1] = index
                                                return -13
                                            if b != 0 and (b < 1 or b >= expected_result):
                                                workspace[0] = 13
                                                workspace[1] = index
                                                return -13
                                            if c != 0 and (c < 1 or c >= expected_result):
                                                workspace[0] = 13
                                                workspace[1] = index
                                                return -13
        if type_id != 0:
            workspace[capacity + result_id - parameter_count + 1] = type_id
            expected_result = expected_result + 1
        index = index + 1
    workspace[0] = 0
    workspace[1] = 0
    return 0

out