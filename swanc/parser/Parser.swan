# Pratt expression parser. AST records: kind, token-index, left-id, right-id, literal.
# Node IDs are one-based. This frontend slice accepts integer expressions.
fn swanc_precedence(kind: int) -> int:
    if kind == 35
        return 3
    if kind == 36 or kind == 37
        return 4
    if kind == 30 or kind == 31
        return 5
    if kind == 32 or kind == 33
        return 6
    return 0

out
fn swanc_add_node(nodes: u32_array, capacity: int, state: u32_array, kind: int, token_index: int, left: int, right: int, literal: int) -> int:
    let count = state[1]
    if count >= capacity
        return -1
    let id = count + 1
    let base = count * 5
    nodes[base] = kind
    nodes[base + 1] = token_index
    nodes[base + 2] = left
    nodes[base + 3] = right
    nodes[base + 4] = literal
    state[1] = id
    return id

out
fn swanc_parse_primary(source: u32_array, tokens: u32_array, token_count: int, nodes: u32_array, node_capacity: int, state: u32_array) -> int:
    let position = state[0]
    if position >= token_count
        return -1
    let token_base = position * 5
    let kind = tokens[token_base]
    if kind == 3
        let start = tokens[token_base + 1]
        let length = tokens[token_base + 2]
        var value = 0
        var i = 0
        while i < length
            let digit = source[start + i] - 48
            if value > 6553
                return -2
            value = value * 10 + digit
            if value > 65535
                return -2
            i = i + 1
        state[0] = position + 1
        return swanc_add_node(nodes, node_capacity, state, 1, position, 0, 0, value)
    if kind == 38
        state[0] = position + 1
        let inner = swanc_parse_expression(source, tokens, token_count, nodes, node_capacity, state, 1)
        if inner < 1 or state[0] >= token_count
            return -3
        if tokens[state[0] * 5] != 39
            return -3
        state[0] = state[0] + 1
        return inner
    return -5

out
fn swanc_parse_expression(source: u32_array, tokens: u32_array, token_count: int, nodes: u32_array, node_capacity: int, state: u32_array, minimum: int) -> int:
    var left = swanc_parse_primary(source, tokens, token_count, nodes, node_capacity, state)
    if left < 1
        return -1
    var running = 1
    while running == 1 and state[0] < token_count
        let position = state[0]
        let kind = tokens[position * 5]
        let precedence = swanc_precedence(kind)
        if precedence < minimum
            running = 0
        else
            state[0] = position + 1
            let right = swanc_parse_expression(source, tokens, token_count, nodes, node_capacity, state, precedence + 1)
            if right < 1
                return -2
            left = swanc_add_node(nodes, node_capacity, state, 4, position, left, right, 0)
            if left < 1
                return -3
    return left

out
fn swanc_parse(source: u32_array, tokens: u32_array, token_count: int, nodes: u32_array, node_capacity: int, state: u32_array) -> int:
    if token_count < 2 or node_capacity < 1
        return -1
    state[0] = 0
    state[1] = 0
    let root = swanc_parse_expression(source, tokens, token_count, nodes, node_capacity, state, 1)
    if root < 1
        return -2
    while state[0] < token_count and tokens[state[0] * 5] == 5
        state[0] = state[0] + 1
    if state[0] >= token_count or tokens[state[0] * 5] != 1
        return -3
    return root

out
