# Swan Compiler 2 — Control-Flow Graph verifier
#
# A basic block is five u32 words:
# [terminator, successor_a, successor_b, predecessor_count, flags]
# Block IDs are one-based. Successor 0 means no edge.
# Terminators: 1 return, 2 unconditional branch, 3 conditional branch,
# 4 unreachable. Flags are reserved and must be zero.
#
# Workspace: [error_code, block_index, observed, reachable_count,
#             predecessor_counts[block_count], visited[block_count],
#             BFS_queue[block_count]].
# The caller owns all storage. The verifier never allocates.
#
# Return 0 for a valid graph, negative for a malformed graph. Unreachable
# blocks are reported through workspace[3], not rejected: later reachability
# and dead-block passes decide whether they can be removed.

fn swanc_cfg_verify(blocks: u32_array, block_count: int, workspace: u32_array, workspace_capacity: int) -> int:
    if block_count < 1 or block_count > 429496729:
        workspace[0] = 1
        workspace[1] = 0
        workspace[2] = block_count
        return -1
    let required = 4 + block_count * 3
    if workspace_capacity < required:
        workspace[0] = 2
        workspace[1] = 0
        workspace[2] = required
        return -2

    let pred_base = 4
    let visit_base = pred_base + block_count
    let queue_base = visit_base + block_count
    var index = 0
    while index < block_count:
        workspace[pred_base + index] = 0
        workspace[visit_base + index] = 0
        index = index + 1

    # Validate every terminator and edge before following any edge.
    index = 0
    while index < block_count:
        let base = index * 5
        let terminator = blocks[base]
        let first = blocks[base + 1]
        let second = blocks[base + 2]
        let declared_predecessors = blocks[base + 3]
        let flags = blocks[base + 4]
        if flags != 0:
            workspace[0] = 3
            workspace[1] = index + 1
            workspace[2] = flags
            return 0 - 3
        if terminator < 1 or terminator > 4:
            workspace[0] = 4
            workspace[1] = index + 1
            workspace[2] = terminator
            return 0 - 4

        if terminator == 1 or terminator == 4:
            if first != 0 or second != 0:
                workspace[0] = 5
                workspace[1] = index + 1
                workspace[2] = first
                return 0 - 5
        else
            if terminator == 2:
                if first < 1 or first > block_count or second != 0:
                    workspace[0] = 6
                    workspace[1] = index + 1
                    workspace[2] = first
                    return 0 - 6
            else
                if first < 1 or first > block_count or second < 1 or second > block_count:
                    workspace[0] = 7
                    workspace[1] = index + 1
                    workspace[2] = first
                    return 0 - 7
        index = index + 1

    # Compute predecessor counts from edges, with overflow-safe bounds.
    index = 0
    while index < block_count:
        let base = index * 5
        let terminator = blocks[base]
        let first = blocks[base + 1]
        let second = blocks[base + 2]
        if terminator == 2 or terminator == 3:
            let slot_a = pred_base + first - 1
            workspace[slot_a] = workspace[slot_a] + 1
            if workspace[slot_a] > block_count * 2:
                workspace[0] = 8
                workspace[1] = first
                workspace[2] = workspace[slot_a]
                return 0 - 8
        if terminator == 3:
            let slot_b = pred_base + second - 1
            workspace[slot_b] = workspace[slot_b] + 1
            if workspace[slot_b] > block_count * 2:
                workspace[0] = 8
                workspace[1] = second
                workspace[2] = workspace[slot_b]
                return 0 - 8
        index = index + 1

    index = 0
    while index < block_count:
        let declared = blocks[index * 5 + 3]
        let observed = workspace[pred_base + index]
        if declared != observed:
            workspace[0] = 9
            workspace[1] = index + 1
            workspace[2] = observed
            return 0 - 9
        index = index + 1
    if workspace[pred_base] != 0:
        workspace[0] = 10
        workspace[1] = 1
        workspace[2] = workspace[pred_base]
        return 0 - 10

    # Iterative breadth-first traversal from entry block 1.
    # This avoids recursion and bounds queue growth to block_count.
    var head = 0
    var tail = 1
    workspace[queue_base] = 1
    workspace[visit_base] = 1
    while head < tail:
        let current = workspace[queue_base + head]
        head = head + 1
        let base = (current - 1) * 5
        let terminator = blocks[base]
        let first = blocks[base + 1]
        let second = blocks[base + 2]
        if terminator == 2 or terminator == 3:
            let slot_a = visit_base + first - 1
            if workspace[slot_a] == 0:
                workspace[slot_a] = 1
                workspace[queue_base + tail] = first
                tail = tail + 1
        if terminator == 3:
            let slot_b = visit_base + second - 1
            if workspace[slot_b] == 0:
                workspace[slot_b] = 1
                workspace[queue_base + tail] = second
                tail = tail + 1
    workspace[0] = 0
    workspace[1] = 0
    workspace[2] = 0
    workspace[3] = tail
    return 0
out
